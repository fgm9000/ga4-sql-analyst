# Virtual environment
.venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Type checker cache
.mypy_cache/

# Test and coverage caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# Environment files
.env
.env.*
!.env.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Spikes local output
spikes/out/

# Terraform local variables (contain the billing account ID)
infra/terraform.tfvars
